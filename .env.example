# =============================================================================
# MeliAutoPublish AI - Variáveis de ambiente
# Copie este arquivo para ".env" e preencha os valores.
# =============================================================================

# --- Banco de dados (SQLite) -------------------------------------------------
# O arquivo do banco é criado dentro de prisma/dev.db
DATABASE_URL="file:./dev.db"

# --- Aplicação ----------------------------------------------------------------
# URL base da aplicação (usada para montar o redirect_uri do OAuth).
# Em produção troque para o domínio público (https://...).
APP_URL="http://localhost:3000"

# --- Mercado Livre (OAuth 2.0) -----------------------------------------------
# Crie um app em https://developers.mercadolivre.com.br/devcenter
# O "redirect_uri" cadastrado no app DEVE ser exatamente:
#   {APP_URL}/api/auth/callback
ML_CLIENT_ID=""
ML_CLIENT_SECRET=""
ML_REDIRECT_URI="http://localhost:3000/api/auth/callback"
ML_SITE_ID="MLB"

# --- Google Gemini (IA gratuita) ---------------------------------------------
# Obtenha uma API key gratuita em https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Recomendado pelo projeto: gemini-1.5-flash.
# Se o modelo estiver indisponível na sua conta, use "gemini-2.0-flash".
GEMINI_MODEL="gemini-1.5-flash"
